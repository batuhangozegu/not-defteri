# Bu dosyayı .env olarak kopyalayıp gerçek değerlerle doldurun: cp .env.example .env
# .env asla commit edilmez (bkz. .gitignore).

# --- Veritabanı (PostgreSQL + pgvector) ---
DB_URL=jdbc:postgresql://localhost:5432/notdefteri
DB_USERNAME=
DB_PASSWORD=
POSTGRES_DB=notdefteri
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- Ollama (yerel embedding, ileride Raspberry Pi üzerinde) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- Google Gemini (bulut AI, cevap üretimi) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# --- Kimlik doğrulama (JWT) ---
# En az 32 karakter olmalı (HS256 için). Üretmek için: openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRATION_MINUTES=10080

# --- Backend ---
SERVER_PORT=8080
# Frontend'in çalıştığı adres(ler), virgülle ayrılmış. Varsayılan "*" (bu API sadece
# Authorization header'ı ile doğrulama yapar, cookie kullanmaz, bu yüzden wildcard güvenli).
# LAN/Pi kurulumunda genelde değiştirmeye gerek yok; kısıtlamak isterseniz örn:
# CORS_ALLOWED_ORIGINS=http://192.168.1.50:5173,http://raspberrypi.local:5173
CORS_ALLOWED_ORIGINS=*

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8080
